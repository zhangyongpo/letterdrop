<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主页面静态背景：深蓝→午夜蓝的斜向渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#2A3A60"
                android:centerColor="#1B2233"
                android:endColor="#0E111A" />
        </shape>
    </item>
    <!-- 顶部柔光，增加层次（纯静态，不参与游戏） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.30"
                android:gradientRadius="65%p"
                android:startColor="#4668A8"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
